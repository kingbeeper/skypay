# Postgres connection string. For Neon, use the POOLED connection string
# (the host contains "-pooler") so serverless invocations don't exhaust
# connections. Find it in the Neon dashboard → Connection Details.
DATABASE_URL=postgresql://USER:PASS@HOST-pooler.region.aws.neon.tech/dbname?sslmode=require

# iron-session encryption secret. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
# Or in PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | %{[char]$_})
SESSION_SECRET=replace-me-with-a-32+-character-random-string
