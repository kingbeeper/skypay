generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  name          String?
  kycStatus     String        @default("pending")
  isDemo        Boolean       @default(false)
  isAdmin       Boolean       @default(false)
  totpSecret    String?
  totpEnabled   Boolean       @default(false)
  recoveryCodes String?       // JSON array of unused hashed recovery codes
  failedLogins  Int           @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  streakDays    Int           @default(0)
  createdAt     DateTime      @default(now())
  balances      Balance[]
  transactions  Transaction[]
  cards         Card[]
  raffleEntries RaffleEntry[]
  raffleWins    RaffleRound[] @relation("RaffleWinner")
  notifications Notification[]
  watchlist     Watchlist[]
  priceAlerts   PriceAlert[]
  referralCode  String?       @unique
  referredById  String?
  referredBy    User?         @relation("ReferredBy", fields: [referredById], references: [id])
  referred      User[]        @relation("ReferredBy")
  achievements  Achievement[]
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  earnedAt  DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     String
  createdAt DateTime @default(now())

  @@unique([userId, asset])
}

model PriceAlert {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset        String
  direction    String   // "above" | "below"
  targetUsd    Float
  triggered    Boolean  @default(false)
  triggeredAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, triggered])
  @@index([asset, triggered])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Webhook {
  id          String         @id @default(cuid())
  name        String
  url         String
  enabled     Boolean        @default(true)
  secret      String?
  createdAt   DateTime       @default(now())
  lastFiredAt DateTime?
  events      WebhookEvent[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorEmail String
  action    String
  targetId  String?
  targetLabel String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  webhookId String
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType String
  status    String   @default("delivered")
  payload   String
  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
}

model Card {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String            @default("virtual")
  status               String            @default("active")
  pan                  String
  last4                String
  expMonth             Int
  expYear              Int
  cvv                  String
  holderName           String
  spendingSource       String            @default("USD")
  monthlyLimit         Float             @default(2000)
  dailyPurchaseLimit   Float             @default(1000)
  dailyWithdrawalLimit Float             @default(500)
  cashbackPercent      Float             @default(1.0)
  colorTheme           String            @default("indigo")
  physicalRequested    Boolean           @default(false)
  createdAt            DateTime          @default(now())
  transactions         CardTransaction[]
}

model CardTransaction {
  id           String   @id @default(cuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  merchant     String
  category     String
  amountUsd    Float
  sourceAsset  String
  sourceAmount Float
  rate         Float
  cashbackUsd  Float    @default(0)
  status       String   @default("approved")
  createdAt    DateTime @default(now())

  @@index([cardId, createdAt])
}

model Balance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     String
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, asset])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  fromAsset   String?
  toAsset     String?
  fromAmount  Float?
  toAmount    Float?
  rate        Float?
  status      String   @default("completed")
  description String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model RaffleRound {
  id               String        @id @default(cuid())
  drawsAt          DateTime
  prizeBtc         Float          @default(1.0)
  ticketPriceUsd   Float          @default(20.0)
  syntheticTickets Int            @default(0)
  status           String         @default("open") // open | drawn
  winnerUserId     String?
  winner           User?          @relation("RaffleWinner", fields: [winnerUserId], references: [id])
  winnerHandle     String?
  winnerTickets    Int?
  totalTicketsAtDraw Int?
  drawnAt          DateTime?
  createdAt        DateTime       @default(now())
  entries          RaffleEntry[]

  @@index([status, drawsAt])
}

model RaffleEntry {
  id        String      @id @default(cuid())
  roundId   String
  round     RaffleRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets   Int         @default(0)
  spentUsd  Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([roundId, userId])
  @@index([userId])
}
